<Project>

  <!--
    Settings shared by every project in this solution.

    Unlike projects 001-003, TargetFramework(s) is NOT set here: .Core and test projects
    build net10.0 alone, while .Demo projects multi-target the MAUI platform heads. A single
    central TargetFramework would either force every .Core project to carry platform TFMs it
    never uses, or force every .Demo project down to net10.0 alone and lose the platforms
    entirely. This is the one documented MAUI-specific deviation from the inherited baseline
    (reviewed prompt R4; specification DEC-7).
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Warnings fail the build. A reference implementation that compiles with
      warnings teaches the warnings along with the patterns.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Analyser rules are suppressed in the projects that need them, never here.
      The project that earns the suppression carries the reason beside the code.
    -->
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Demo')) and $([MSBuild]::IsOSPlatform('windows'))">
    <!--
      .Demo (MAUI app) projects redirect obj/ and bin/ to a short path outside this deeply
      nested workspace tree. Verified by execution as the actual fix, not a guess: the
      Android build failed with APT2098/APT2261 ("failed to open file") on a resource this
      SDK generates itself (microsoft_maui_essentials_fileprovider_file_paths.xml), which
      aapt2.exe, a native tool with its own path-length ceiling independent of Windows'
      own LongPathsEnabled setting, could not write once the intermediate path (deep
      workspace root, plus patterns/<Pattern>/src/<Pattern>.Demo/obj/Debug/net10.0-android/
      lp/<N>/jl/flat/...) grew past roughly 220 characters. Confirmed against a public
      report of the identical error and fix: dotnet/android#7971. Renaming the pattern
      folder shorter bought some margin but is not durable as pattern names grow; redirecting
      the intermediate path is the standard, permanent fix for this class of Windows/Android
      build failure.

      Conditioned on Windows, deliberately. A drive-letter path means nothing to macOS or Linux,
      where MSBuild would resolve it relative to the project and create a folder named after the
      drive inside every .Demo directory. Those hosts keep the default obj/ and bin/, and the
      ceiling this works around is a Windows and aapt2 problem in the first place. Two checkouts
      of this repository on one Windows machine share this cache; clear it for a genuinely fresh
      build.
    -->
    <BaseIntermediateOutputPath>C:\maui-obj\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>C:\maui-obj\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
