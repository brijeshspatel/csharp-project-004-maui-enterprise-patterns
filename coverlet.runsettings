<?xml version="1.0" encoding="utf-8"?>
<RunSettings>

  <!--
    Coverage settings for the whole solution, declared once.

    Format is cobertura only, and no deterministic report. Asking for the opencover
    format alongside a deterministic report throws inside the collector, and the throw
    does not fail the run: every assembly reports a pass while not one coverage file is
    written. Verification therefore checks that the report files exist rather than
    trusting the exit code (this workspace's own documented failure mode).

    Every *.Demo project is excluded, and this is the one deliberate exclusion in this
    repository (unlike project 003, which excludes nothing). *.Demo projects are thin
    .NET MAUI platform heads: XAML, code behind, and platform service registration, with
    no business logic of their own. Business and view model logic lives in *.Core, which
    remains fully in scope. This is DEC-7, Phase 1, of the specification: unit tests
    cover *.Core; device or emulator execution of *.Demo is a named future phase, not
    part of this coverage measurement.
  -->

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*.Demo]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

</RunSettings>
