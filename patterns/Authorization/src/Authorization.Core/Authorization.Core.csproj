<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    No package, and deliberately no reference to Authentication.Core. The pattern projects here do
    not reference one another: identity is that entry's subject and permission is this one's, and
    the seam between them, 401 against 403, is described in the README and implemented by
    neither.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
