<Project>

  <!--
    Shared test configuration.

    This lives in Directory.Build.targets rather than Directory.Build.props because MSBuild
    imports .props before a project file is read and .targets after it. A test project
    declares IsTestProject in its own body, so only the later import can see it.
  -->

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <!--
      CA1707 forbids underscores in member names. It is a rule about identifiers other
      people call, and nobody calls a test method: the runner does. Underscores are what
      make a failing test name readable in a run report, so the rule is relaxed for test
      projects and nowhere else.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
